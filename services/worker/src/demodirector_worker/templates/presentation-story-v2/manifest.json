    "width": 2560,
    "height": 1440,
    "color_space": "sRGB",
    "safe_area": {
      "x": 128,
      "y": 86,
      "width": 2304,
      "height": 1270
    }
  },
  "preview_canvas": {
    "width": 1280,
    "height": 720
  },
  "contact_sheet_png": "contact-sheet.png",
  "tokens": "tokens.json",
  "motion": "motion.json",
  "typography": {
    "family": "Inter",
    "source": "shared/inter-latin-variable.woff2",
    "tokens": {
      "display_xl": {
        "size": 132,
        "line_height": 138,
        "weight": 500,
        "tracking": -4
      },
      "display_l": {
        "size": 88,
        "line_height": 96,
        "weight": 500,
        "tracking": -3
      },
      "heading": {
        "size": 56,
        "line_height": 64,
        "weight": 600,
        "tracking": -1.5
      },
      "title": {
        "size": 40,
        "line_height": 48,
        "weight": 600,
        "tracking": -0.5
      },
      "body": {
        "size": 30,
        "line_height": 42,
        "weight": 400,
        "tracking": 0
      },
      "label": {
        "size": 22,
        "line_height": 28,
        "weight": 600,
        "tracking": 4.4
      },
      "caption": {
        "size": 44,
        "line_height": 54,
        "weight": 500,
        "tracking": -0.5
      }
    }
  },
  "palette": {
    "hook": "#0D4334",
    "field": "#234D44",
    "fieldRaised": "#2C5B50",
    "mint": "#9DE8D2",
    "mintSoft": "#DDF7EF",
    "ivory": "#F3EDE1",
    "ink": "#0A211C",
    "inkSoft": "#173D34",
    "coral": "#FF796C",
    "line": "#73BDAA",
    "white": "#FFFFFF"
  },
  "transition_presets": {
    "hard_cut": {
      "kind": "cut",
      "duration_ms": 0
    },
    "matched_slide": {
      "kind": "translate_fade",
      "duration_ms": 480,
      "easing": "cubic-bezier(0.22, 1, 0.36, 1)",
      "offset_px": [
        36,
        0
      ]
    },
    "field_slide": {
      "kind": "translate_fade",
      "duration_ms": 420,
      "easing": "cubic-bezier(0.22, 1, 0.36, 1)",
      "offset_px": [
        0,
        28
      ]
    },
    "aperture_expand": {
      "kind": "scale_fade",
      "duration_ms": 560,
      "easing": "cubic-bezier(0.22, 1, 0.36, 1)",
      "origin": "center",
      "start_scale": 0.96
    },
    "focus_rise": {
      "kind": "translate_fade",
      "duration_ms": 520,
      "easing": "cubic-bezier(0.16, 1, 0.3, 1)",
      "offset_px": [
        0,
        32
      ]
    },
    "card_stagger": {
      "kind": "staggered_translate_fade",
      "duration_ms": 520,
      "item_stagger_ms": 160,
      "easing": "cubic-bezier(0.22, 1, 0.36, 1)",
      "offset_px": [
        0,
        26
      ]
    },
    "soft_crossfade": {
      "kind": "crossfade",
      "duration_ms": 500,
      "easing": "cubic-bezier(0.4, 0, 0.2, 1)"
    }
  },
  "schedule": [
    {
      "start_ms": 0,
      "end_ms": 3000,
      "template_id": "hook-question@2",
      "transition_preset": "hard_cut"
    },
    {
      "start_ms": 3000,
      "end_ms": 5000,
      "template_id": "brand-promise@2",
      "transition_preset": "matched_slide"
    },
    {
      "start_ms": 5000,
      "end_ms": 20000,
      "template_id": "context-split@2",
      "transition_preset": "matched_slide"
    },
    {
      "start_ms": 20000,
      "end_ms": 37000,
      "template_id": "workflow-rail@2",
      "transition_preset": "field_slide"
    },
    {
      "start_ms": 37000,
      "end_ms": 53000,
      "template_id": "prompt-over-product@2",
      "transition_preset": "aperture_expand"
    },
    {
      "start_ms": 53000,
      "end_ms": 70000,
      "template_id": "focus-detail@2",
      "transition_preset": "focus_rise"
    },
    {
      "start_ms": 70000,
      "end_ms": 90000,
      "template_id": "human-review@2",
      "transition_preset": "field_slide"
    },
    {
      "start_ms": 90000,
      "end_ms": 115000,
