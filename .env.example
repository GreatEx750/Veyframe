# Google Cloud
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_API_KEY=
GEMINI_REASONING_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_LIVE_SMOKE_TEST=0
GEMINI_TTS_LIVE_SMOKE_TEST=0

# Partner Search
PARALLEL_API_KEY=
PARALLEL_SEARCH_MODE=fast
PARALLEL_LIVE_SMOKE_TEST=0

# Storage and database
DEMO_ARTIFACT_BUCKET=
DEMO_METADATA_BACKEND=sqlite
DEMO_FIRESTORE_DATABASE=(default)

# Application
APP_ENV=development
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
CAPTURE_MAX_SECONDS=240
RENDER_MAX_SECONDS=600
INSPECT_MAX_PAGES=3
INSPECT_MAX_DEPTH=1
INSPECT_TIMEOUT_MS=10000
DEMO_ARTIFACTS_DIR=artifacts
# Exact origins that may receive the current user's session during authenticated self-capture.
DEMO_CAPTURE_AUTH_ORIGINS=

# Durable generation: run python -m demodirector_api.job_worker locally.
# Cloud Tasks must target the API service itself, not the capture-only worker.
DEMO_GENERATION_TASK_URL=
DEMO_TASK_QUEUE=
DEMO_TASK_LOCATION=us-central1
DEMO_TASK_INVOKER_SERVICE_ACCOUNT=
# Optional locally; required from Secret Manager for cloud authenticated self-capture.
# A Fernet key encrypts the short-lived capture session; never commit its value.
DEMO_JOB_TOKEN_KEY=
# Rendered video reviews: at most one request per attempt; never run in default tests.
GEMINI_REVIEW_MODEL=gemini-3.5-flash-lite
RUN_LIVE_VIDEO_REVIEW=0

# Authentication and judge access
DEMO_AUTH_REQUIRED=false
DEMO_AUTH_REQUIRE_VERIFIED_EMAIL=false
DEMO_SESSION_TTL_SECONDS=43200
IDENTITY_PLATFORM_API_KEY=
DEMO_JUDGE_ENABLED=true
DEMO_JUDGE_SESSION_TTL_SECONDS=3600
